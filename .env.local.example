VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (no VITE_ prefix — these must never reach the browser
# bundle). Used by api/fatsecret-search.js to sign requests to the
# FatSecret Platform API. Get these from platform.fatsecret.com.
FATSECRET_CLIENT_ID=your-fatsecret-client-id
FATSECRET_CLIENT_SECRET=your-fatsecret-client-secret

# Push notifications (reminders). Generate a keypair with:
#   npx web-push generate-vapid-keys
# The public key is safe client-side (VITE_ prefix); the private key must
# stay server-only.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Server-only — used by api/send-reminders.js to read across all users
# when deciding who to notify. Get this from Supabase dashboard:
# Settings -> API -> service_role key. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only — used by api/recognize-food.js (photo food recognition).
# Get this from console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server-only — used by api/transcribe-voice.js (voice-to-text food
# search). A different provider than the Anthropic key above, since
# transcription isn't a Claude API capability. Get this from
# platform.openai.com -> API Keys. Costs ~$0.006/minute of audio.
OPENAI_API_KEY=your-openai-api-key
